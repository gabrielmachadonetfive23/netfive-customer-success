# Banco de dados (Supabase Postgres — Project Settings/Connect > Connection string)
# DATABASE_URL: transaction pooler (porta 6543) — usada em runtime pela aplicação
DATABASE_URL="postgresql://postgres.xxxxxxxxxxxx:sua-senha@aws-0-regiao.pooler.supabase.com:6543/postgres?pgbouncer=true"
# DIRECT_URL: session pooler ou conexão direta (porta 5432) — usada apenas para rodar migrations
DIRECT_URL="postgresql://postgres.xxxxxxxxxxxx:sua-senha@aws-0-regiao.pooler.supabase.com:5432/postgres"

# Segredo usado para derivar o hash do token de sessão (gere com: openssl rand -hex 32)
AUTH_SECRET="troque-este-valor-para-um-segredo-aleatorio-de-64-caracteres"

# Login é por e-mail + senha (tabela User, senha com hash+salt via scrypt).
# Não há mais uma allowlist por variável de ambiente — quem tem acesso é quem
# tem um registro em User. Para criar/dar acesso a alguém novo:
#   npm run user:create -- email@netfive.com.br
# O comando imprime uma senha provisória; a pessoa é obrigada a trocá-la no
# primeiro login (tela /trocar-senha).

# Integração Smartsheet (sincronização de duas vias)
SMARTSHEET_API_TOKEN="coloque-o-token-de-api-do-smartsheet"
SMARTSHEET_SHEET_ID="id-da-planilha-smartsheet"
# Segredo retornado pela Smartsheet ao criar o webhook (usado para validar a assinatura recebida)
SMARTSHEET_WEBHOOK_SECRET="preenchido-automaticamente-ao-registrar-o-webhook"

# Integração Pipedrive (sincronização de duas vias)
PIPEDRIVE_API_TOKEN="coloque-o-token-de-api-do-pipedrive"
PIPEDRIVE_DOMAIN="suaempresa" # em https://suaempresa.pipedrive.com
# Segredo definido por você ao cadastrar o webhook no Pipedrive (usado com Basic Auth)
PIPEDRIVE_WEBHOOK_SECRET="defina-um-segredo-para-o-webhook"

# URL pública da aplicação, necessária para registrar os webhooks (ex.: https://cs.netfive.com.br)
PUBLIC_APP_URL="https://localhost:3000"

# Protege /api/cron/sync e /api/cron/qbr (rotinas periódicas chamadas pelo
# GitHub Actions a cada 30min — ver .github/workflows/sync-cron.yml). Gere com: openssl rand -hex 32
CRON_SECRET="troque-este-valor-para-um-segredo-aleatorio"

# Integração Notion (sincronização somente leitura da base "QBR/SBR - Atividades Abertas")
# 1. Crie uma integration interna em https://www.notion.so/my-integrations e copie o "Internal Integration Secret".
# 2. Na base do Notion, abra o menu "..." > "Conectar a" > selecione a integration criada.
# 3. NOTION_QBR_DATA_SOURCE_ID é o ID do Data Source da base (visível na URL como collection://<id> ao inspecionar a base via API/MCP).
NOTION_API_TOKEN="coloque-o-token-da-integration-do-notion"
NOTION_QBR_DATA_SOURCE_ID="id-do-data-source-da-base-qbr-sbr"
