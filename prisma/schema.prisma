// Netfive Customer Success — Prisma schema
// Banco: PostgreSQL (Supabase). DATABASE_URL usa o transaction pooler (runtime,
// serverless-friendly); DIRECT_URL usa o session pooler/conexão direta,
// necessária para rodar migrations (o modo transaction não suporta prepared
// statements exigidos pelo Prisma Migrate).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ---------------------------------------------------------------------------
// Autenticação
// ---------------------------------------------------------------------------

model UserSession {
  id        String   @id @default(uuid())
  email     String
  tokenHash String   @unique
  createdAt DateTime @default(now())
  expiresAt DateTime

  @@index([email])
  @@index([expiresAt])
}

model User {
  id           String  @id @default(uuid())
  email        String  @unique
  passwordHash String
  passwordSalt String

  // Forçado no primeiro login (senha provisória) — controla o redirecionamento para /trocar-senha.
  mustChangePassword Boolean @default(true)

  // Bloqueio simples por tentativas de login incorretas (defesa contra força bruta).
  failedLoginAttempts Int       @default(0)
  lockedUntil         DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([email])
}

// ---------------------------------------------------------------------------
// Domínio de Customer Success
// ---------------------------------------------------------------------------

model Customer {
  id String @id @default(uuid())

  companyName String
  csOwner     String
  category    String // AA | A | B | C | D | E

  segment             String?
  segmentSourceTitle   String?
  segmentSourceUrl     String?
  segmentVerifiedAt    DateTime?

  contactName  String?
  contactRole  String?
  contactInfo  String? // telefone e/ou e-mail do contato principal
  technicalOwner String?

  startDate   DateTime?
  renewalDate DateTime?

  healthScore  Int? // 0-100, nulo = "Não avaliado"
  healthStatus String @default("Não avaliado") // Saudável | Atenção | Crítico | Não avaliado
  healthReason String?
  attentionPoints String?
  actionPlan      String?

  lastContact DateTime?
  nextContact DateTime?
  lastVisit   DateTime?
  nextVisit   DateTime?

  needs              String?
  currentPerception  String?
  expansionPlan      String?
  growthEstimate     String?
  opportunities      String?
  expansionNextStep  String?

  annualRevenue Float? // nulo quando não há dado público, nunca zero
  fiscalYear    Int?
  revenueMetric String? // ex.: faturamento | receita bruta | receita líquida
  revenuePeriod String? // ex.: exercício fiscal, ano civil
  revenueSourceTitle  String?
  revenueSourceUrl    String?
  revenueVerifiedAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  services      CustomerService[]
  observations  Observation[]
  externalLinks ExternalLink[]

  @@index([companyName])
  @@index([csOwner])
  @@index([category])
  @@index([segment])
  @@index([healthStatus])
  @@index([nextContact])
  @@index([nextVisit])
  @@index([lastContact])
  @@index([lastVisit])
  @@index([fiscalYear])
}

model Service {
  id        String   @id @default(uuid())
  name      String   @unique
  active    Boolean  @default(true)
  createdAt DateTime @default(now())

  customers CustomerService[]

  @@index([active])
}

model CustomerService {
  customerId String
  serviceId  String

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  service  Service  @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@id([customerId, serviceId])
  @@index([serviceId])
}

model Observation {
  id         String   @id @default(uuid())
  customerId String
  text       String
  author     String
  createdAt  DateTime @default(now())

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId])
  @@index([createdAt])
}

// ---------------------------------------------------------------------------
// Auditoria
// ---------------------------------------------------------------------------

model AuditLog {
  id         String   @id @default(uuid())
  action     String // customer.create | customer.update | customer.delete | observation.create
  entityId   String
  actor      String
  detail     String?
  createdAt  DateTime @default(now())

  @@index([entityId])
  @@index([action])
}

// ---------------------------------------------------------------------------
// Integrações externas (Smartsheet / Pipedrive) — sincronização de duas vias
// ---------------------------------------------------------------------------

model ExternalLink {
  id                String   @id @default(uuid())
  customerId        String
  provider          String // "smartsheet" | "pipedrive"
  externalId        String // ID da linha (Smartsheet) ou do negócio/organização (Pipedrive)
  externalUpdatedAt DateTime? // timestamp de última modificação reportado pelo sistema externo
  lastSyncedAt      DateTime  @default(now())
  lastSyncDirection String // "push" | "pull"

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@unique([provider, externalId])
  @@unique([customerId, provider])
  @@index([customerId])
}

model SyncLog {
  id         String   @id @default(uuid())
  provider   String // "smartsheet" | "pipedrive"
  direction  String // "push" | "pull"
  customerId String?
  status     String // "success" | "error" | "skipped"
  message    String?
  createdAt  DateTime @default(now())

  @@index([provider])
  @@index([customerId])
  @@index([createdAt])
}

// ---------------------------------------------------------------------------
// Notícias — coletadas diariamente de fontes oficiais (RSS), filtradas por
// relevância para os segmentos de clientes da Netfive e por segurança da
// informação.
// ---------------------------------------------------------------------------

model NewsArticle {
  id           String   @id @default(uuid())
  title        String
  summary      String?
  url          String   @unique
  sourceName   String
  sourceDomain String
  publishedAt  DateTime
  category     String // "segmento" | "seguranca"
  segments     String[] // segmentos de clientes relacionados (ex.: ["Agronegócio"]) — pode ser vazio em notícias de segurança gerais
  tags         String[] // palavras-chave que geraram o match (ex.: ["investimento", "phishing"])
  createdAt    DateTime @default(now())

  @@index([category])
  @@index([publishedAt])
}

// ---------------------------------------------------------------------------
// QBR/SBR — atividades abertas importadas do Notion (base "QBR/SBR -
// Atividades Abertas - Segurança"), sincronizadas periodicamente.
// ---------------------------------------------------------------------------

model QbrActivity {
  id           String    @id @default(uuid())
  notionPageId String    @unique
  notionUrl    String
  activity     String // Atividade
  cliente      String?
  team         String? // Time (GRC | GRH | NGSOC | Engenharia SI | Red Team | Segurança)
  responsavel  String?
  status       String?
  tipo         String? // QBR | SBR
  quarter      String?
  overdue      Boolean   @default(false) // Atrasada = Sim
  agidesk      String?
  dueDate      DateTime?
  lastSyncedAt DateTime  @default(now())
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([cliente])
  @@index([status])
  @@index([team])
  @@index([overdue])
  @@index([dueDate])
}

// ---------------------------------------------------------------------------
// NPS — respostas da pesquisa de satisfação, cadastradas manualmente (ainda
// não há integração automática com a ferramenta de pesquisa).
// ---------------------------------------------------------------------------

model NpsResponse {
  id          String    @id @default(uuid())
  companyName String
  score       Int? // 0-10; nulo = empresa participante sem nota lançada ainda
  respondedAt DateTime?
  notes       String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([companyName])
}
